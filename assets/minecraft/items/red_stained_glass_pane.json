{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "model",
      "model": "item/red_stained_glass_pane"
    },
    "cases": [
      {
        "when": "red_portal",
        "model": {
          "type": "model",
          "model": "item/hub/red_portal"
        }
    },
    {
        "when": "magical_circel_red",
        "model": {
          "type": "model",
          "model": "item/magical_circels/magical_circel_red"
        }
      },
      {
        "when": "magical_circel_red_2",
        "model": {
          "type": "model",
          "model": "item/magical_circels/magical_circel_red_2"
        }
      }
    ]
  }
}